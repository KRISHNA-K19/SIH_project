# ==========================================
# VERITAS — Unified Repository .gitignore
# ==========================================

# ------------------------------------------
# Frontend (Next.js / Node.js)
# ------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
build/
dist/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

*.tsbuildinfo
next-env.d.ts
.vercel/

# ------------------------------------------
# Backend (Python / FastAPI / Alembic)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.installed.cfg
*.egg

.pytest_cache/
.coverage
htmlcov/

# Local document storage uploads (preserve .gitkeep)
backend/storage/documents/original/*
!backend/storage/documents/original/.gitkeep
backend/storage/documents/processed/*
!backend/storage/documents/processed/.gitkeep

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# ------------------------------------------
# OS & Editor Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
