# ==============================================================================
# VERITAS Environment Configuration Example
# Copy this file to .env and replace placeholder values with secure credentials.
# ==============================================================================

# Application Metadata
PROJECT_NAME="VERITAS – AI-Based Fake Identity & Document Screening System"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veritas_db"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veritas_test_db"

# Security & JWT Token Configuration
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Storage Configuration (Private local directories outside public paths)
STORAGE_DIR="storage"
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_EXTENSIONS=".jpg,.jpeg,.png"

# CORS Configuration (comma-separated origins)
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Initial Administrator Seed (optional, created only if no admin exists)
ADMIN_INITIAL_EMAIL="admin@veritas.local"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"
ADMIN_INITIAL_NAME="System Administrator"

# Analysis Engine Policy
ANALYSIS_POLICY_VERSION="1.0.0"
MRZ_CHECK_ENABLED=true
IMAGE_QUALITY_CHECK_ENABLED=true
OCR_ENABLED=true
